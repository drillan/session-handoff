{
  "description": "計測用の暫定フック（Task 1）。実装完了時に pre-compact.sh / session-start.sh へ差し替える。",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dump-input.sh\" PreCompact '${CLAUDE_PLUGIN_DATA}' '${CLAUDE_PLUGIN_ROOT}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dump-input.sh\" SessionStart '${CLAUDE_PLUGIN_DATA}' '${CLAUDE_PLUGIN_ROOT}'"
          }
        ]
      }
    ]
  }
}
